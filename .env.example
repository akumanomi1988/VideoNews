# Local defaults. Never commit this file with real credentials.

# ChatGPT-first Studio
VIDEO_STUDIO_DIR=output/studio
VIDEO_ENABLE_PAID_IMAGE_GENERATION=true
VIDEO_IMAGE_MAX_SCENES_PER_JOB=12
VIDEO_IMAGE_MAX_ATTEMPTS_PER_SCENE=2

# News discovery
SERPAPI_API_KEY=
NEWS_API_KEY=
CURRENTS_API_KEY=
NEWS_LANGUAGE=es
SERPAPI_USE_CACHE=true
SERPAPI_CACHE_TTL_HOURS=24

# Optional automated-provider CLI fallback; not used to author Studio scripts
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=

# Secondary licensed stock media; use only when a project explicitly selects it
PEXELS_API_KEY=
MEDIA_SOURCE=huggingface

# NewSphere Cinematic primary image provider (Azure MAI). These calls can incur
# charges; keep the key local and leave an empty endpoint/key to fail preflight.
AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_API_KEY=
AZURE_IMAGE_MODEL=

# Voice and rendering
TTS_PROVIDER=edge
TTS_VOICE=es-ES-ElviraNeural
TTS_LANGUAGE=es
VIDEO_RENDER_RESOLUTION=1080p
VIDEO_OUTPUT_DIR=output
VIDEO_TEMP_DIR=.temp
VIDEO_BACKGROUND_MUSIC=
VIDEO_BACKGROUND_MUSIC_REQUIRED=false
VIDEO_RENDER_PRESET=veryfast
VIDEO_RENDER_CRF=20

# YouTube OAuth. Keep client secrets and token under ignored .secrets/.
YOUTUBE_CLIENT_SECRETS_FILE=.secrets/client_secret.json
YOUTUBE_TOKEN_FILE=.secrets/token.json
# New NewSphere productions use the isolated CPU runtime (setup_local_voice.ps1).
TTS_PROVIDER=kokoro
KOKORO_VOICE=em_alex
KOKORO_SPEED=1.0
KOKORO_DEVICE=cpu
