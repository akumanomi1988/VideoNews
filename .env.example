# Copy to .env. Never commit real credentials or OAuth tokens.
TELEGRAM_BOT_TOKEN=
# Mandatory: comma-separated numeric Telegram user IDs. Bot denies all without it.
TELEGRAM_ALLOWED_USER_IDS=

# News collection
SERPAPI_API_KEY=
NEWS_API_KEY=
CURRENTS_API_KEY=
PEXELS_API_KEY=
NEWS_LANGUAGE=es
SERPAPI_USE_CACHE=true
SERPAPI_CACHE_TTL_HOURS=24

# LLM: Ollama first; optional Groq/Azure failover
OLLAMA_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=nemotron-3-super:cloud
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=gpt-4o-mini

# Images: pexels is the zero-configuration default, huggingface selects
# Azure generation with automatic Pexels fallback.
MEDIA_SOURCE=pexels
AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_API_KEY=
AZURE_IMAGE_MODEL=MAI-Image-2e

# Narration and publishing
TTS_VOICE=es-ES-ElviraNeural
TTS_LANGUAGE=es
YOUTUBE_CLIENT_SECRETS_FILE=.secrets/client_secret.json
VIDEO_UPLOAD_ENABLED=false
VIDEO_OUTPUT_DIR=output
VIDEO_TEMP_DIR=.temp
VIDEO_BACKGROUND_MUSIC=
TIKTOK_SESSION_FILE=

# Optional TikTok inbox posting (requires user-approved video.upload scope)
VIDEO_UPLOAD_PLATFORM=youtube
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_TOKEN_FILE=.secrets/tiktok_token.json

# Voice engines: edge (default), elevenlabs or bark
TTS_PROVIDER=edge
ELEVENLABS_ACCOUNTS_FILE=elevenlabsaccounts.payload.json
ELEVENLABS_MIN_QUOTA=100
BARK_VOICE=v2/es_speaker_3
BARK_LOW_VRAM=false

# Editorial policy (neutral by default, configurable)
NEWS_EDITORIAL_IDEOLOGY=
NEWS_EDITORIAL_TONE=

# Rendering profiles and limits (lower values reduce video generation costs)
VIDEO_RENDER_RESOLUTION=1080p
VIDEO_SHORT_SCENES=8
VIDEO_LONG_SCENES=18

# Durable jobs (persist on Docker volume; protect from deletion)
VIDEO_JOBS_DB=videonews_jobs.sqlite3
VIDEO_YOUTUBE_PRIVACY=private
