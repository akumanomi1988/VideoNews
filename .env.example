# Local defaults. Never commit this file with real credentials.

# ChatGPT-first Studio
VIDEO_STUDIO_DIR=output/studio
VIDEO_ENABLE_PAID_IMAGE_GENERATION=false

# News discovery
SERPAPI_API_KEY=
NEWS_API_KEY=
CURRENTS_API_KEY=
NEWS_LANGUAGE=es
SERPAPI_USE_CACHE=true
SERPAPI_CACHE_TTL_HOURS=24

# Optional automated-provider CLI fallback; not used to author Studio scripts
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=

# Optional stock media for automated CLI fallback
PEXELS_API_KEY=
MEDIA_SOURCE=pexels

# Paid image automation (leave disabled for default ChatGPT-assisted workflow)
AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_API_KEY=
AZURE_IMAGE_MODEL=

# Voice and rendering
TTS_PROVIDER=edge
TTS_VOICE=es-ES-ElviraNeural
TTS_LANGUAGE=es
VIDEO_RENDER_RESOLUTION=1080p
VIDEO_OUTPUT_DIR=output
VIDEO_TEMP_DIR=.temp

# YouTube OAuth. Keep client secrets and token under ignored .secrets/.
YOUTUBE_CLIENT_SECRETS_FILE=.secrets/client_secret.json
YOUTUBE_TOKEN_FILE=.secrets/token.json
