# Copy to .env. Never commit real credentials or OAuth tokens.
TELEGRAM_BOT_TOKEN=
# Mandatory: comma-separated numeric Telegram user IDs. Bot denies all without it.
TELEGRAM_ALLOWED_USER_IDS=

# News collection
SERPAPI_API_KEY=
NEWS_API_KEY=
CURRENTS_API_KEY=
PEXELS_API_KEY=
NEWS_LANGUAGE=es
SERPAPI_USE_CACHE=true
SERPAPI_CACHE_TTL_HOURS=24

# LLM: Ollama first; optional Groq/Azure failover
OLLAMA_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=nemotron-3-super:cloud
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=gpt-4o-mini

# Images: pexels is the zero-configuration default, huggingface selects
# Azure generation with automatic Pexels fallback.
MEDIA_SOURCE=pexels
AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_API_KEY=
AZURE_IMAGE_MODEL=MAI-Image-2e

# Narration and publishing
TTS_VOICE=es-ES-ElviraNeural
TTS_LANGUAGE=es
YOUTUBE_CLIENT_SECRETS_FILE=.secrets/client_secret.json
VIDEO_UPLOAD_ENABLED=false
VIDEO_OUTPUT_DIR=output
VIDEO_TEMP_DIR=.temp
VIDEO_BACKGROUND_MUSIC=
TIKTOK_SESSION_FILE=
